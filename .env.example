# 复制为 .env 后填写。至少需要一个对话模型的密钥，人物才会说话。

# 阿里云百炼（北京区）：通义千问对话、语音合成（人物的声音）、语音识别（对着麦克风说中文）
DASHSCOPE_API_KEY=

# Lumina AI 网关：Claude / DeepSeek 对话与 GPT Image 生图（梅里爱剧照、梵高的椅子等礼物）
# 没有 LUMINA_API_KEY 时依次尝试 TRIPO_API_KEY、CODEX_API_KEY
LUMINA_API_KEY=
LUMINA_BASE_URL=https://lumina.tripo3d.com

# 可选
# PORT=8794                 后端端口（scripts/dev.mjs 会把 /life-learn/api/ 转发到这里）
# WEB_PORT=8080             本地前端端口
# LIFE_DATA_DIR=./data      访客、计划、缓存等运行数据
# LEARN_KG=off              关掉词卡里由模型现写的「易混词、搭配、偏误、语料」四栏
# LIFE_OPEN=melies,vangogh,lishizhen,xiyou   开放哪几段人生
